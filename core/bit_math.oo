// # oobinary Bit Math Operations
//
// Logline: Bit manipulation primitives including bit-string formatting, reversal, and rotations.
//
// Setup: Pure mathematical bitwise algorithms operating strictly within bounded 8-bit domains.
//
// Beats:
//   1. Convert bytes to 8-character binary bit representations and vice versa.
//   2. Reverse bit ordering within single bytes for endianness inversion.
//   3. Perform circular bitwise left and right rotations with modulo wrapping.

fn nibble_char(n: Int) -> String {
    let v: Int = n & 15;
    if v == 0 { return "0"; }
    if v == 1 { return "1"; }
    if v == 2 { return "2"; }
    if v == 3 { return "3"; }
    if v == 4 { return "4"; }
    if v == 5 { return "5"; }
    if v == 6 { return "6"; }
    if v == 7 { return "7"; }
    if v == 8 { return "8"; }
    if v == 9 { return "9"; }
    if v == 10 { return "a"; }
    if v == 11 { return "b"; }
    if v == 12 { return "c"; }
    if v == 13 { return "d"; }
    if v == 14 { return "e"; }
    return "f";
}

pub fn byte_to_hex(b: Int) -> String {
    let hi: Int = (b >> 4) & 15;
    let lo: Int = b & 15;
    return nibble_char(hi) + nibble_char(lo);
}

pub fn hex_char_val(c: String) -> Int {
    if c == "0" { return 0; }
    if c == "1" { return 1; }
    if c == "2" { return 2; }
    if c == "3" { return 3; }
    if c == "4" { return 4; }
    if c == "5" { return 5; }
    if c == "6" { return 6; }
    if c == "7" { return 7; }
    if c == "8" { return 8; }
    if c == "9" { return 9; }
    if c == "a" || c == "A" { return 10; }
    if c == "b" || c == "B" { return 11; }
    if c == "c" || c == "C" { return 12; }
    if c == "d" || c == "D" { return 13; }
    if c == "e" || c == "E" { return 14; }
    if c == "f" || c == "F" { return 15; }
    return 0;
}

pub fn byte_to_bit_str(b: Int) -> String {
    let mut out: String = "";
    let mut i: Int = 7;
    while i >= 0 {
        let bit: Int = (b >> i) & 1;
        if bit == 1 {
            out = out + "1";
        } else {
            out = out + "0";
        }
        i = i - 1;
    }
    return out;
}

pub fn bit_str_to_byte(s: String) -> Int {
    let n: Int = chars_len(s);
    let mut acc: Int = 0;
    let mut i: Int = 0;
    while i < n && i < 8 {
        let c: String = char_at(s, i);
        let bit: Int = if c == "1" { 1 } else { 0 };
        acc = (acc << 1) | bit;
        i = i + 1;
    }
    return acc & 255;
}

pub fn reverse_bits8(b: Int) -> Int {
    let mut v: Int = b & 255;
    let mut r: Int = 0;
    let mut i: Int = 0;
    while i < 8 {
        r = (r << 1) | (v & 1);
        v = v >> 1;
        i = i + 1;
    }
    return r;
}

pub fn rotate_left8(b: Int, amount: Int) -> Int {
    let val: Int = b & 255;
    let shift: Int = amount % 8;
    if shift == 0 { return val; }
    let shifted: Int = (val << shift) | (val >> (8 - shift));
    return shifted & 255;
}

pub fn rotate_right8(b: Int, amount: Int) -> Int {
    let val: Int = b & 255;
    let shift: Int = amount % 8;
    if shift == 0 { return val; }
    let shifted: Int = (val >> shift) | (val << (8 - shift));
    return shifted & 255;
}
